# ============================================================
# dnai-wikigen — Environment Variables
# ============================================================
# Copy to .env and fill in your values:
#   cp example.env .env
#
# NEVER commit .env to git. Only example.env is tracked.
# ============================================================

# ------------------------------------------------------------
# Foundry / Smart Contracts (Base Network)
# ------------------------------------------------------------

# Etherscan V2 API key (works for BaseScan verification)
# Get one at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Read-only activation authority requires a second independent provider. It
# must resolve to a different endpoint digest and agree on the common finalized
# block, reconstructed release bytecode, and all seven runtime code hashes.
BASE_SEPOLIA_SECONDARY_RPC_URL=
# Production email-oracle authorization requires a second HTTPS provider on a
# different host. Do not alias this to BASE_SEPOLIA_RPC_URL.
BASE_SEPOLIA_RPC_URL_SECONDARY=
BASE_MAINNET_RPC_URL=https://mainnet.base.org
ANVIL_RPC_URL=http://127.0.0.1:8545

# Fresh-suite deployment inputs. DEPLOYMENT_OPERATOR must be the address derived
# from the encrypted Foundry keystore account named `dev`. The deployment helper
# never infers this address and refuses any other keystore account name.
DEPLOYMENT_OPERATOR=
FOUNDRY_KEYSTORE_ACCOUNT=dev
BROADCAST=false
VERIFY=false
RELEASE_SHA=
# Immutable pre-deployment intent and renewable review envelope. All paths used
# by activation helpers must be absolute regular non-symlink paths. The final
# authority is created only after real contract/CVM facts exist; its digest must
# never be fabricated or recorded as an input to the initial broadcast.
DEPLOYMENT_INTENT_PATH=
DEPLOYMENT_INTENT_SHA256=
FINAL_RELEASE_AUTHORITY_CORE_PATH=
OPERATOR_POLICY_FINAL_AUTHORITY_SHA256=
OPERATOR_POLICY_REVIEW_ENVELOPE_PATH=
OPERATOR_POLICY_REVIEW_ENVELOPE_SHA256=
OPERATOR_POLICY_REVIEW_EVIDENCE_SHA256=
DEPLOYMENT_MANIFEST_PATH=./deployments/base-sepolia.json
# Required for every BROADCAST=true post-authority ceremony. This must be an
# existing canonical absolute mode-0700 directory outside the repository. All
# release writers contend on one release-SHA-scoped lock; abnormal exit leaves
# it stale until the explicit two-reviewer recovery protocol is satisfied.
RELEASE_CEREMONY_LOCK_ROOT=
# Mandatory fresh-suite EmailOracleAuth timelock. The production helper accepts
# 2 days through 365 days and deploys with no CVM/device/consumer allowlist.
EMAIL_ORACLE_UPGRADE_DELAY=172800
# The developer is a mandatory fresh-deployment role. The metering verifier is
# deliberately bound only after deployment, once the exact vault address and
# runtime hash can be included in its externally hashed QVL policy set.
COMPUTE_VAULT_DEVELOPER=
COMPUTE_VAULT_METERING_VERIFIER=
# Purpose-separated raw EIP-712 signer controlled by the compute-metering QVL
# CVM. Both metering verifier roles are post-deployment inputs. At the release
# ceremony and live gate, all five contract trust-root roles must be nonzero
# and pairwise distinct.
COMPUTE_VAULT_METERING_QVL_VERIFIER=
COMPUTE_METERING_POLICY_SET_HASH=
COMPUTE_VAULT_DEVELOPER_FEE_BPS=100
# Three-phase, timelocked post-deployment compute activation. The helper uses
# only Foundry account `dev`; phases 2 and 3 cannot run until each preceding
# on-chain two-day timelock has elapsed. The final phase requires exactly one
# ERC20 asset (canonical Base Sepolia USDC), two rate policies, one compose
# hash, exactly one registered execution TEE, and zero pending admissions. It
# permanently freezes the distinct meter/QVL signer pair and policy, assets, rates, compose hashes,
# and TEE identities before it unpauses funding or execution.
COMPUTE_VAULT_ADDRESS=
# Exact fresh-suite runtime keccak256 from the append-only deployment ledger.
# Every phase and the helper compare the live extcodehash before governance.
COMPUTE_VAULT_RUNTIME_CODE_HASH=
COMPUTE_VAULT_TEE_IDENTITY=
COMPUTE_VAULT_COMPOSE_HASH=
COMPUTE_VAULT_NATIVE_RATE_POLICY_COMMITMENT=
COMPUTE_VAULT_ERC20_RATE_POLICY_COMMITMENT=
COMPUTE_VAULT_NATIVE_PROVIDER=
COMPUTE_VAULT_ERC20_PROVIDER=
COMPUTE_RELEASE_PHASE=1

# Deployed contract addresses (populated only after a successful broadcast)
EMAIL_ORACLE_AUTH_ADDRESS=
# Exact keccak256 of the deployed EmailOracleAuth runtime bytecode.
EMAIL_ORACLE_AUTH_RUNTIME_CODE_HASH=
DILIGENCE_ROOM_ADDRESS=
# Three-phase post-attestation admission for the exact diligence CVM. Phase 1
# proposes the compose hash, phase 2 activates it and proposes the TEE binding,
# and phase 3 activates that binding and permanently freezes both addition
# paths. Each phase is separated by the contract's two-day timelock.
DILIGENCE_RUNTIME_CODE_HASH=
DILIGENCE_TEE_IDENTITY=
DILIGENCE_COMPOSE_HASH=
DILIGENCE_ATTESTATION_VERIFIER=
DILIGENCE_QVL_RELEASE_POLICY_HASH=
# Exact ordered public descriptors for the three reviewed deterministic
# evaluator recipes. Commitments must be distinct nonzero bytes32 values and
# the root must equal DiligenceRoom.computeEvaluatorPolicySetRoot([1,2,3]).
DILIGENCE_EVALUATOR_POLICY_COMMITMENT_1=
DILIGENCE_EVALUATOR_POLICY_COMMITMENT_2=
DILIGENCE_EVALUATOR_POLICY_COMMITMENT_3=
DILIGENCE_EVALUATOR_POLICY_SET_ROOT=
DILIGENCE_RELEASE_PHASE=1
# Two-phase monotonic execution-policy anchor activation. Fresh suites deploy
# this contract paused with no writer. The helper validates the canonical,
# no-symlink release-core artifact, derives its domain-separated SHA-256 digest,
# and refuses any release SHA/operator/anchor code/writer mismatch. It never
# accepts an opaque operator-chosen commitment. Phase 1 proposes that exact
# CVM-controlled writer/core pair; after two days, phase 2 activates it,
# permanently freezes writer rotation, and unpauses the still-empty anchor.
EXECUTION_POLICY_ANCHOR_ADDRESS=
EXECUTION_POLICY_ANCHOR_RUNTIME_CODE_HASH=
EXECUTION_POLICY_ANCHOR_WRITER=
EXECUTION_POLICY_RELEASE_CORE_PATH=
EXECUTION_POLICY_ANCHOR_RELEASE_PHASE=1
TINKER_ENCUMBRANCE_CONTRACT_ADDRESS=
# Two-phase exact Tinker release ceremony. Fresh deployments stay halted until
# phase 1 binds the account commitment, per-operation caps, one reviewed compose
# hash, and an explicit optional delegated manager (zero address means none).
# Phase 2 may run only after the on-chain two-day review delay, then atomically
# freezes that baseline policy and unhalts bounded non-custodial operations.
TINKER_ENCUMBRANCE_ADDRESS=
TINKER_ENCUMBRANCE_RUNTIME_CODE_HASH=
TINKER_ENCUMBRANCE_RELEASE_ACCOUNT_COMMITMENT=
TINKER_ENCUMBRANCE_RELEASE_MAX_ADD_BALANCE_WEI=
TINKER_ENCUMBRANCE_RELEASE_MAX_SPEND_WEI=
TINKER_ENCUMBRANCE_RELEASE_COMPOSE_HASH=
TINKER_ENCUMBRANCE_RELEASE_MANAGER=0x0000000000000000000000000000000000000000
TINKER_ENCUMBRANCE_RELEASE_PHASE=1
ROYALTY_DISTRIBUTOR_ADDRESS=
# Two-phase exact Arena genesis ceremony. The helper derives the complete
# variable-length catalog from the canonical final-authority artifact; no
# per-challenge environment fields are accepted. Phase 1 requires the pristine
# fresh registry and creates contiguous IDs 1..N at version 1. Phase 2 may run
# only after every on-chain two-day review window, then freezes and Opens every
# exact challenge while proving zero pending owners/controllers and pause latches.
# For BROADCAST=true, override the repository-local manifest default with an
# existing canonical absolute ledger path outside this checkout, and set
# FOUNDRY_BROADCAST to an existing canonical absolute directory outside this
# checkout. Keeping both external preserves the same clean RELEASE_SHA across
# the two-day wait; copy/anchor the completed ledger only after phase 2.
# DEPLOYMENT_MANIFEST_PATH=/absolute/release-evidence/base-sepolia.json
# FOUNDRY_BROADCAST=/absolute/release-evidence/forge-broadcast
CHALLENGE_REGISTRY_ADDRESS=
CHALLENGE_REGISTRY_RUNTIME_CODE_HASH=
CHALLENGE_REGISTRY_RELEASE_PHASE=1
COMPUTE_CREDIT_VAULT_ADDRESS=

# Legacy service aliases retained until all runtime consumers migrate.
ESCROW_ADDRESS=
JUDGE_ADDRESS=

# DiligenceRoom result verifier address for the post-deployment ceremony. It is
# intentionally absent from the fresh-suite constructor and pre-measurement CVM
# launch authority. The measured final authority must bind a nonzero address
# distinct from every other contract trust-root role before live activation.
DILIGENCE_RESULT_VERIFIER=

# TEE-held result-verifier key path and short authorization TTL.
TINKER_CHAIN_RESULT_VERIFIER_KEY_PATH=tinker/chain_result_verifier
TINKER_CHAIN_RESULT_AUTHORIZATION_TTL_SECONDS=300
TINKER_CHAIN_ATTESTATION_RELEASE_POLICY_HASH=
# Deal settlement obtains a fresh signed verdict-v3 from the exact Diligence
# QVL root after a one-time signed challenge-v2 exchange. All deployment pins,
# release-lineage pins, and the policy hash come from one
# generated release candidate; the bearer is delivered only to deal-runtime.
TINKER_DILIGENCE_QVL_URL=
TINKER_DILIGENCE_QVL_VERIFIER_ADDRESS=
TINKER_DILIGENCE_QVL_RELEASE_POLICY_HASH=
TINKER_DILIGENCE_ALLOWED_COMPOSE_HASH=
TINKER_DILIGENCE_ALLOWED_APP_ID=
TINKER_DILIGENCE_ALLOWED_OS_IMAGE_HASH=
TINKER_DILIGENCE_QVL_AUTH_TOKEN=

# ------------------------------------------------------------
# Phala Cloud / TEE (dstack)
# ------------------------------------------------------------

# Phala Cloud API key (prefixed with phak_)
# Get one at: https://cloud.phala.com
PHALA_CLOUD_API_KEY=

# Five purpose-separated QVL CVMs are deployed independently: Diligence, Arena,
# execution-policy anchor writer, compute workload, and compute metering. The compose uses
# these generic names inside each CVM's own encrypted deployment environment;
# never reuse one policy or signer across the five deployments. The QVL checks
# the supplied activation challenge but deliberately does not persist the
# external activation verifier's replay ledger.
QVL_IMAGE_REPOSITORY=ghcr.io/therealwiki/dnai-wikigen/attestation-qvl
QVL_IMAGE_DIGEST=
QVL_RELEASE_POLICY_B64=
QVL_AUTH_TOKEN=
QVL_MAX_CONCURRENCY=4
QVL_RATE_CAPACITY=30
QVL_RATE_REFILL_PER_SECOND=0.5
QVL_CHALLENGE_TTL_SECONDS=60
QVL_CHALLENGE_CAPACITY=1024
QVL_REQUEST_BODY_TIMEOUT_SECONDS=5
# Keep the two sequential server phases at or below 25s, leaving headroom for
# the five QVL clients' 30s end-to-end request timeout.
QVL_VERIFICATION_TIMEOUT_SECONDS=20

# Independent compute-metering CVM deployment. METERING_POLICY_SET_B64 is the
# reviewed canonical public policy encoded as base64. It must contain both
# sorted native/USDC entries, their exact provider recipients and commitments,
# the one-TEE/one-compose active cardinalities, and zero pending admissions.
# RPC/auth values are secrets delivered with Phala encrypted environment
# variables. The image must be the project-owned GHCR repository plus an
# immutable sha256 digest; changing the policy set rotates its derived signer.
METERING_IMAGE_REPOSITORY=ghcr.io/therealwiki/dnai-wikigen/compute-metering
METERING_IMAGE_DIGEST=
METERING_POLICY_SET_B64=
METERING_RPC_URL=
METERING_AUTH_TOKEN=
# Dedicated compute-metering QVL release pins. The metering CVM requests a
# fresh one-time challenge, binds its raw TDX quote to that challenge, and
# accepts only the independently signed v3 verdict from this exact QVL root.
METERING_QVL_URL=
METERING_QVL_AUTH_TOKEN=
METERING_QVL_VERIFIER_ADDRESS=
METERING_QVL_RELEASE_POLICY_HASH=
METERING_CVM_ID=
METERING_DEPLOYMENT_INTENT_SHA256=
METERING_RELEASE_AUTHORITY_SHA256=
METERING_CEREMONY_NONCE=
METERING_QVL_MEASUREMENT_POLICY_SHA256=
# Purpose-specific bearer used only by the Tinker compute runtime to call the
# metering QVL. Never reuse Diligence, Arena, anchor-writer, or metering API
# bearer values for this credential.
TINKER_COMPUTE_METERING_QVL_AUTH_TOKEN=
METERING_RPC_TIMEOUT_SECONDS=8
METERING_MAX_CONCURRENCY=4
METERING_RATE_CAPACITY=30
METERING_RATE_REFILL_PER_SECOND=0.5
METERING_REQUEST_BODY_TIMEOUT_SECONDS=5

# Neko's production browser UI credentials are distinct internal secrets.
# Never use the upstream development defaults `neko` / `admin`, and never use
# the same value for both accounts. The activation environment helper can
# provision both without printing either value.
NEKO_PASSWORD=
NEKO_PASSWORD_ADMIN=

# Phala Cloud API endpoint (default: https://cloud.phala.com)
PHALA_CLOUD_API_PREFIX=

# Phala credentials directory (default: ~/.phala-cloud)
PHALA_CLOUD_DIR=

# Phala CLI update channel: latest | beta
PHALA_UPDATE_CHANNEL=latest

# CVM deployment settings
PHALA_APP_NAME=
PHALA_INSTANCE_TYPE=tdx.medium
PHALA_REGION=
PHALA_CVM_ID=
PHALA_DISK_SIZE=20G

# Release-validator trust roots: exactly five distinct verifier addresses, one
# each for the Diligence, Arena, anchor-writer, compute-workload, and
# compute-metering QVLs.
# Supply deployment-specific values only in .env; never copy values here.
TRUSTED_ATTESTATION_VERIFIER_ADDRESSES=

# Online activation is an external verifier for all five QVL CVMs. Each value
# must exactly equal the matching release candidate's HTTPS /verify endpoint;
# preflight derives /attestation, sends POST with a random one-time challenge,
# consumes that challenge in its own bounded replay ledger, and independently
# verifies the returned raw Intel TDX quote with DCAP. GET/self-declared QVL
# identity documents are never activation authority.
ACTIVATION_DILIGENCE_QVL_URL=
ACTIVATION_ARENA_QVL_URL=
ACTIVATION_ANCHOR_WRITER_QVL_URL=
ACTIVATION_COMPUTE_WORKLOAD_QVL_URL=
ACTIVATION_COMPUTE_METERING_QVL_URL=
ACTIVATION_RELEASE_CANDIDATE_PATH=
ACTIVATION_ARTIFACT_EVIDENCE_PATH=
ACTIVATION_ARENA_EVIDENCE_PATH=
ACTIVATION_ANCHOR_WRITER_EVIDENCE_PATH=
ACTIVATION_EMAIL_ORACLE_EVIDENCE_PATH=

# KMS configuration: phala | ethereum | base
PHALA_KMS_TYPE=phala

# dstack / TEE runtime. The simulator endpoint is local-development only;
# remove/unset it in every Phala environment (the Arena dstack overlays also
# hard-code it empty and the worker refuses to start when it is configured).
DSTACK_SIMULATOR_ENDPOINT=http://localhost:8090
DSTACK_SOCKET=/var/run/dstack.sock
DSTACK_MODE=socket

# ------------------------------------------------------------
# AI / LLM API Keys (via OpenRouter)
# ------------------------------------------------------------

# OpenRouter API key
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model selection (optional overrides)
OPENROUTER_MODEL=

# ------------------------------------------------------------
# Docker / Container Registry
# ------------------------------------------------------------

# Docker Hub or GHCR credentials (for pushing TEE images)
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
DOCKER_IMAGE=

# Docker host (for remote Docker engines / dstack executor)
DOCKER_HOST=

# ------------------------------------------------------------
# Blockchain KMS (for Ethereum/Base KMS mode)
# ------------------------------------------------------------

# dstack-derived key path for on-chain KMS registration. Raw private-key
# environment variables are intentionally unsupported.
KMS_SIGNER_KEY_PATH=kms/registration-signer

# RPC URL for KMS chain
KMS_RPC_URL=

# ------------------------------------------------------------
# Application / Agent Configuration
# ------------------------------------------------------------

# Server port for TEE services
PORT=3000

# Judge/result-verifier signer is derived inside dstack from this key path.
JUDGE_SIGNER_KEY_PATH=judge/result-verifier
JUDGE_PORT=3003

# Agent service
AGENT_HOST=localhost
AGENT_PORT=3001
CHAT_PORT=3001

# TEE email oracle and Tinker delegate runtime auth.
# Local dev: set ORACLE_RUNTIME_AUTH_TOKEN and TINKER_ORACLE_AUTH_TOKEN to the
# same high-entropy value. dstack/Phala: leave tokens empty and require auth so
# both services derive the bearer token from ORACLE_RUNTIME_AUTH_KEY_PATH.
ORACLE_PRODUCTION_RELEASE=false
ORACLE_DSTACK_ENABLED=false
ORACLE_DSTACK_KEY_PATH=email/creds
ORACLE_RUNTIME_AUTH_REQUIRED=false
ORACLE_RUNTIME_AUTH_TOKEN=
ORACLE_RUNTIME_AUTH_KEY_PATH=oracle/runtime-auth
ORACLE_AUTH_REQUIRED=false
ORACLE_AUTH_CONTRACT_ADDRESS=
ORACLE_AUTH_RPC_URL=
ORACLE_AUTH_RPC_URL_SECONDARY=
ORACLE_AUTH_CHAIN_ID=84532
ORACLE_AUTH_CONTRACT_RUNTIME_CODE_HASH=
ORACLE_AUTH_CONSUMER_APP_ID=
ORACLE_AUTH_CONSUMER_COMPOSE_HASH=
ORACLE_AUTH_EXPECTED_CALLER_IDENTITY=tinker-delegate.signup
ORACLE_AUTH_MAX_FINALIZED_BLOCK_AGE_SECONDS=900
ORACLE_AUTH_MAX_FUTURE_BLOCK_SKEW_SECONDS=30
ORACLE_AUTH_CHECKPOINT_STORE_PATH=/data/email_auth_checkpoint.json
ORACLE_OTP_REPLAY_STORE_PATH=/data/otp_replay.enc
ORACLE_OTP_REPLAY_STORE_KEY=
ORACLE_OTP_REPLAY_KEY_PATH=email/otp_replay
TINKER_ORACLE_AUTH_TOKEN=
TINKER_ORACLE_AUTH_KEY_PATH=oracle/runtime-auth
TINKER_RUNTIME_AUTH_REQUIRED=false
TINKER_RUNTIME_AUTH_TOKEN=
TINKER_RUNTIME_AUTH_KEY_PATH=tinker/runtime-auth
# Exact comma-separated browser origins. Use the final Cloudflare Pages/custom
# HTTPS origin in production; wildcards are rejected. Explicit localhost HTTP
# origins are accepted for local frontend development only.
TINKER_CORS_ALLOWED_ORIGINS=
# Seller wallet authentication (Base Sepolia = 84532). Leave the explicit key
# empty in Phala/dstack so the CVM derives the token key at the configured path.
# Local development may set a high-entropy value of at least 32 characters.
TINKER_WALLET_AUTH_SIGNING_KEY=
TINKER_WALLET_AUTH_KEY_PATH=tinker/wallet_auth
TINKER_WALLET_AUTH_CHALLENGE_TTL_SECONDS=300
TINKER_WALLET_AUTH_TOKEN_TTL_SECONDS=300
TINKER_WALLET_AUTH_MAX_PENDING_CHALLENGES=1024
# Shared Deal/Arena/Compute challenge admission gate. The sliding window must
# cover the longest challenge TTL, and its global limit must stay below every
# pending nonce-store capacity. Address and peer limits are subordinate.
TINKER_WALLET_AUTH_CHALLENGE_LIMIT_WINDOW_SECONDS=600
TINKER_WALLET_AUTH_CHALLENGE_GLOBAL_LIMIT=768
TINKER_WALLET_AUTH_CHALLENGE_ADDRESS_LIMIT=64
TINKER_WALLET_AUTH_CHALLENGE_PEER_LIMIT=256
# Forwarding headers are ignored by default. To trust a reverse proxy, pin its
# exact direct-peer CIDRs and choose one supported single-IP header
# (CF-Connecting-IP or X-Real-IP). Never configure one without the other.
TINKER_WALLET_AUTH_CHALLENGE_TRUSTED_PROXY_CIDRS=
TINKER_WALLET_AUTH_CHALLENGE_CLIENT_IP_HEADER=
TINKER_WALLET_AUTH_ISSUER=dnai-wikigen:wallet-auth
TINKER_WALLET_AUTH_AUDIENCE=dnai-wikigen:tinker-delegate
TINKER_WALLET_AUTH_DOMAIN=www.wikigen.me
TINKER_WALLET_AUTH_URI=https://www.wikigen.me
TINKER_WALLET_AUTH_CHAIN_ID=84532
# Optional contract-wallet verification shared by Deal, Arena, and Compute
# authentication. Empty keeps local EOA-only recovery. Production EIP-1271
# support requires two operator-configured HTTPS Base Sepolia RPCs on distinct
# provider origins. Both must agree at one finalized block on its hash, wallet
# bytecode, and EIP-1271 result; there is no single-provider fallback. Browsers
# and API requests cannot supply or override either URL. Treat both URLs as
# credential-bearing secrets: production launch supplies them only through
# encrypted bootstrap environment authority and never records their values in
# public intent or receipt artifacts.
TINKER_WALLET_AUTH_RPC_URL=
TINKER_WALLET_AUTH_RPC_URL_SECONDARY=
TINKER_WALLET_AUTH_RPC_TIMEOUT_SECONDS=3.0
TINKER_WALLET_AUTH_RPC_MAX_RESPONSE_BYTES=131072
TINKER_WALLET_AUTH_MAX_SIGNATURE_BYTES=4096
# Arena submission auth is cryptographically separate from deal upload auth.
# In dstack/Phala the signing key is derived from this distinct path. Local
# development reuses TINKER_WALLET_AUTH_SIGNING_KEY through a separate domain.
TINKER_ARENA_WALLET_AUTH_KEY_PATH=tinker/arena_wallet_auth
TINKER_ARENA_WALLET_AUTH_CHALLENGE_TTL_SECONDS=300
TINKER_ARENA_WALLET_AUTH_TOKEN_TTL_SECONDS=300
TINKER_ARENA_WALLET_AUTH_MAX_PENDING_CHALLENGES=1024
TINKER_ARENA_WALLET_AUTH_ISSUER=dnai-wikigen:arena-wallet-auth
TINKER_ARENA_WALLET_AUTH_AUDIENCE=dnai-wikigen:arena
# Independent server-side ChallengeRegistry admission. Empty values keep Arena
# ciphertext submission explicitly modeled/non-live: the API fails closed with
# no ingress blob, key, queue, or catalog-state write. At production launch the
# RPC URL is injected only as a Phala-encrypted final-authority runtime secret.
# The address, runtime code hash, canonical approved-bindings JSON, and derived
# approved-set digest are deferred public values produced by the branded
# final-release-authority projection; never hand-fill them or substitute values
# observed in a browser. The bindings JSON is one canonical line and includes
# each row's separate release_policy_commitment. Block age and future skew are
# fixed descriptor defaults, not operator-overridable encrypted inputs. Leave
# the five late-bound values unpopulated until their canonical authority classes
# supply them; keep the two documented descriptor defaults exact.
TINKER_ARENA_REGISTRY_RPC_URL=
TINKER_ARENA_REGISTRY_ADDRESS=
TINKER_ARENA_REGISTRY_RUNTIME_CODE_HASH=
TINKER_ARENA_REGISTRY_APPROVED_CHALLENGE_BINDINGS_JSON=
TINKER_ARENA_REGISTRY_APPROVED_CHALLENGE_SET_SHA256=
TINKER_ARENA_REGISTRY_MAX_BLOCK_AGE_SECONDS=300
TINKER_ARENA_REGISTRY_MAX_FUTURE_BLOCK_SKEW_SECONDS=30
# Durable Arena state contains only authenticated wallet/project metadata,
# bounded manifests, commitments, encrypted-object references, queue state, and
# bounded Ladder releases. Public projections hash both identity fields. Empty
# disables submission writes fail-closed. Use the delegate data volume in
# deployed compose files.
TINKER_ARENA_STORE_PATH=./data/arena_state.json
# Browser-encrypted candidate envelope custody. Production derives the stable
# recipient key from dstack. Local development uses a generated 0600 key file so
# queued ciphertext remains decryptable after a process restart. Never place an
# explicit recipient private key in a deployed environment.
TINKER_ARENA_CANDIDATE_INGRESS_STORE_PATH=./data/arena_candidates
TINKER_ARENA_CANDIDATE_INGRESS_KEY_PATH=tinker/arena_candidate_ingress
TINKER_ARENA_CANDIDATE_INGRESS_LOCAL_KEY_FILE=./data/arena_candidate_ingress.key
TINKER_ARENA_CANDIDATE_INGRESS_PRIVATE_KEY_HEX=
TINKER_ARENA_CANDIDATE_INGRESS_MAX_ENVELOPES=10000
# Internal safe-IR worker. Production accepts only a real dstack CVM and one
# fresh authenticated HTTPS QVL verdict per selected queue job. It rejects the
# simulator, an explicit/private ingress key, and a precomputed verdict file.
# The release manifest schema is dnai.arena.safe-worker-release.v3; its stable
# pins intentionally omit the ephemeral quote hash. Both files must be regular
# 0600 files. Keep the evaluator out of public container layers. The dstack
# overlays run a network-disabled one-shot initializer, then expose the same
# named volume read-only and only to the worker at `/sealed/arena`.
TINKER_ARENA_WORKER_RELEASE_MANIFEST_PATH=./data/arena-worker/release-v2.json
TINKER_ARENA_WORKER_RELEASE_MANIFEST_SHA256=
TINKER_ARENA_WORKER_EVALUATOR_PATH=./data/arena-worker/sealed-evaluator-v1.json
# Source-built dstack/Phala sealed-policy initializer. The two JSON payloads
# must use repository-canonical JSON and unpadded base64url, each decoded value
# is capped at 65536 bytes, and both exact byte hashes use `sha256:<64 hex>`.
# The 32-byte HMAC key also uses unpadded base64url. Compute AUTH_TAG with
# `arena_policy_provisioner.provision_auth_tag`; it authenticates both hashes,
# sizes, the provision schema, and fixed output names. Deliver RELEASE_B64,
# EVALUATOR_B64, AUTH_KEY_B64, AUTH_TAG, and the QVL bearer only as Phala
# encrypted env values.
# Never commit populated values. The initializer consumes and removes these
# variables; neither the public delegate nor the Arena worker receives them.
TINKER_ARENA_PROVISION_RELEASE_B64=
TINKER_ARENA_PROVISION_EVALUATOR_B64=
TINKER_ARENA_PROVISION_EVALUATOR_SHA256=
TINKER_ARENA_PROVISION_AUTH_KEY_B64=
TINKER_ARENA_PROVISION_AUTH_TAG=
# Offline parser/tests only. This must remain empty in a production CVM.
TINKER_ARENA_WORKER_QVL_VERDICT_PATH=
TINKER_ARENA_WORKER_QVL_VERDICT_URL=
# Secret: deliver through Phala's encrypted deployment environment, never an
# image layer or committed env file. At least 16 printable non-space characters.
TINKER_ARENA_WORKER_QVL_AUTH_TOKEN=
TINKER_ARENA_WORKER_POLL_INTERVAL_SECONDS=1.0
# Public safe-IR capability remains modeled unless every descriptor pin below
# is populated by the reviewed release and a fresh HMAC-authenticated worker
# heartbeat matches it. The heartbeat is process-presence evidence, not TDX
# attestation; each job still uses the independent QVL path above. Production
# derives the HMAC key from the distinct dstack path. The explicit key is local
# test/development only and must stay empty in Phala.
TINKER_ARENA_WORKER_LIVE_CAPABILITY_ENABLED=false
TINKER_ARENA_WORKER_RELEASE_SHA=
TINKER_ARENA_WORKER_IMAGE_DIGEST=
# Domain-separated SHA-256 of the exact finite id/version/binding set approved
# by this release. Registry publication alone never changes this value.
TINKER_ARENA_WORKER_APPROVED_CHALLENGE_SET_SHA256=
TINKER_ARENA_WORKER_RELEASE_POLICY_COMMITMENT=
TINKER_ARENA_WORKER_COMPOSE_HASH=
TINKER_ARENA_WORKER_APP_ID=
TINKER_ARENA_WORKER_OS_IMAGE_HASH=
TINKER_ARENA_WORKER_HEARTBEAT_PATH=./data/arena_worker_heartbeat.json
TINKER_ARENA_WORKER_HEARTBEAT_TTL_SECONDS=30
TINKER_ARENA_WORKER_HEARTBEAT_KEY_PATH=tinker/arena_worker_heartbeat
TINKER_ARENA_WORKER_HEARTBEAT_INTEGRITY_KEY=
# Settings uses the TINKER_ prefix; this is distinct from Foundry's
# BASE_SEPOLIA_RPC_URL. Production must provide an HTTPS Base Sepolia endpoint.
TINKER_CHAIN_RPC_URL=
# Compute Console uses authentication and key domains separate from deal,
# Arena, runtime, and upstream proxy credentials. Explicit secrets are local
# development only (at least 32 characters each); leave them empty in dstack.
TINKER_COMPUTE_WALLET_AUTH_SIGNING_KEY=
TINKER_COMPUTE_WALLET_AUTH_KEY_PATH=tinker/compute_wallet_auth
TINKER_COMPUTE_WALLET_AUTH_CHALLENGE_TTL_SECONDS=300
TINKER_COMPUTE_WALLET_AUTH_TOKEN_TTL_SECONDS=600
TINKER_COMPUTE_WALLET_AUTH_MAX_PENDING_CHALLENGES=1024
TINKER_COMPUTE_WALLET_AUTH_ISSUER=dnai-wikigen:compute-wallet-auth
TINKER_COMPUTE_WALLET_AUTH_AUDIENCE=dnai-wikigen:compute-console
TINKER_COMPUTE_CREDENTIAL_SIGNING_KEY=
TINKER_COMPUTE_CREDENTIAL_KEY_PATH=tinker/compute_credentials
TINKER_COMPUTE_CREDENTIAL_ISSUER=dnai-wikigen:compute-credential
TINKER_COMPUTE_CREDENTIAL_AUDIENCE=dnai-wikigen:compute-jobs
TINKER_COMPUTE_CREDENTIAL_MAX_TTL_SECONDS=604800
# Empty disables all Compute state writes fail-closed. This HMAC-authenticated
# store persists only metadata, commitments, service-credit ledger postings,
# and bounded job receipts; never prompts, examples, tokens, or provider keys.
TINKER_COMPUTE_STORE_PATH=./data/compute_console_state.json
TINKER_COMPUTE_STORE_INTEGRITY_KEY=
TINKER_COMPUTE_STORE_INTEGRITY_KEY_PATH=tinker/compute_store_integrity
TINKER_COMPUTE_MAX_OPERATOR_GRANT_CREDITS=100000
TINKER_COMPUTE_MAX_PROJECT_BALANCE_CREDITS=1000000
# Exact-asset chain dispatch is isolated from the modeled service-credit store
# above. Empty path disables metadata intent writes. In a real dstack CVM leave
# the explicit integrity key empty so the purpose-separated key is derived.
TINKER_COMPUTE_DISPATCH_STORE_PATH=./data/compute_exact_asset_dispatch.json
TINKER_COMPUTE_DISPATCH_STORE_INTEGRITY_KEY=
TINKER_COMPUTE_DISPATCH_STORE_INTEGRITY_KEY_PATH=tinker/compute_dispatch_store_integrity
# Execution-CVM release pins. RPC and metering must be HTTPS. The metering URL
# must target the final strict POST /meter endpoint. These public values must
# come from one generated release packet, never hand-copied placeholders. The
# source-build dstack compose exposes the worker under the explicit
# `compute-execution` profile and shares both journals through delegate-data.
TINKER_COMPUTE_CHAIN_RPC_URL=
TINKER_COMPUTE_VAULT_ADDRESS=
TINKER_COMPUTE_VAULT_RUNTIME_CODE_HASH=
TINKER_COMPUTE_VAULT_COMPOSE_HASH=
TINKER_COMPUTE_METERING_POLICY_SET_HASH=
TINKER_COMPUTE_EXECUTION_SIGNER_KEY_PATH=tinker/compute_execution_identity
TINKER_COMPUTE_METERING_URL=
# Secret bearer delivered only through Phala encrypted environment.
TINKER_COMPUTE_METERING_AUTH_TOKEN=
TINKER_COMPUTE_EXECUTION_CONFIRMATIONS=2
TINKER_COMPUTE_EXECUTION_POLL_INTERVAL_SECONDS=1.0
TINKER_COMPUTE_EXECUTION_MAX_BLOCK_AGE_SECONDS=300
TINKER_COMPUTE_EXECUTION_MAX_FUTURE_BLOCK_SKEW_SECONDS=30
# Ciphertext-only Compute workload ingress. A real upload still requires a
# fresh independent QVL activation for the exact dstack-derived X25519
# recipient; these storage settings alone never enable it. Local keys are for
# development/tests and are rejected by the production activation gate.
TINKER_COMPUTE_WORKLOAD_INGRESS_STORE_PATH=./data/compute_workload_ingress
TINKER_COMPUTE_WORKLOAD_INGRESS_INTEGRITY_KEY=
TINKER_COMPUTE_WORKLOAD_INGRESS_INTEGRITY_KEY_PATH=tinker/compute_workload_ingress_integrity
TINKER_COMPUTE_WORKLOAD_INGRESS_KEY_PATH=tinker/compute_workload_ingress
TINKER_COMPUTE_WORKLOAD_INGRESS_LOCAL_KEY_FILE=./data/compute_workload_ingress.key
TINKER_COMPUTE_WORKLOAD_INGRESS_PRIVATE_KEY_HEX=
TINKER_COMPUTE_WORKLOAD_INGRESS_MAX_ENVELOPES=10000
# Dedicated fifth-QVL recipient activation. The URL must end in /verify and
# the bearer is an independent encrypted secret; never reuse the Diligence,
# Arena, anchor-writer, or Compute-metering QVL credential.
TINKER_COMPUTE_WORKLOAD_QVL_URL=
TINKER_COMPUTE_WORKLOAD_QVL_AUTH_TOKEN=
TINKER_COMPUTE_WORKLOAD_QVL_VERIFIER_ADDRESS=
TINKER_COMPUTE_WORKLOAD_QVL_RELEASE_POLICY_HASH=
TINKER_COMPUTE_WORKLOAD_QVL_MAX_VERDICT_AGE_SECONDS=300
TINKER_COMPUTE_WORKLOAD_QVL_REVOKED_QUOTE_HASHES_JSON=[]
TINKER_COMPUTE_WORKLOAD_CHAIN_ID=84532
TINKER_COMPUTE_WORKLOAD_FRESH_DEPLOYMENT_RECEIPT_SHA256=
TINKER_COMPUTE_WORKLOAD_CVM_ID=
TINKER_COMPUTE_WORKLOAD_DEPLOYMENT_INTENT_SHA256=
TINKER_COMPUTE_WORKLOAD_RELEASE_AUTHORITY_SHA256=
TINKER_COMPUTE_WORKLOAD_CEREMONY_NONCE=
TINKER_COMPUTE_WORKLOAD_MEASUREMENT_POLICY_SET_SHA256=
TINKER_COMPUTE_WORKLOAD_QVL_MEASUREMENT_POLICY_SHA256=
TINKER_COMPUTE_WORKLOAD_MAIN_RUNTIME_EVIDENCE_SHA256=
# Browser upload is enabled only when this complete, workload-specific trust
# group is emitted by the signed release projection. Do not reuse Diligence or
# Compute-metering QVL roots. Fresh quote hashes are not pinned as immutable
# identity; the sorted revocation list plus the <=300s verdict age bound lets a
# refreshed signed quote retain the same exact recipient-release identity.
VITE_ENABLE_COMPUTE_WORKLOAD_UPLOAD=false
VITE_COMPUTE_WORKLOAD_QVL_VERIFIER=
VITE_COMPUTE_WORKLOAD_QVL_RELEASE_POLICY_HASH=
VITE_COMPUTE_WORKLOAD_COMPOSE_HASH=
VITE_COMPUTE_WORKLOAD_APP_ID=
VITE_COMPUTE_WORKLOAD_OS_IMAGE_HASH=
VITE_COMPUTE_WORKLOAD_ACTIVATION_SIGNER=
VITE_COMPUTE_WORKLOAD_CHAIN_ID=84532
VITE_COMPUTE_WORKLOAD_CONTRACT_ADDRESS=
VITE_COMPUTE_WORKLOAD_VAULT_RUNTIME_CODE_HASH=
VITE_COMPUTE_WORKLOAD_FRESH_DEPLOYMENT_RECEIPT_SHA256=
VITE_COMPUTE_WORKLOAD_MAX_VERDICT_AGE_SECONDS=120
VITE_COMPUTE_WORKLOAD_REVOKED_QUOTE_HASHES_JSON=[]
# Durable bounded policy decisions consulted again at execution time. The file
# contains only hashes/decisions/timestamps. Leave the explicit key empty in
# dstack so the purpose-separated key path is derived inside the CVM. Delegate,
# Arena, and Compute workers must resolve this exact same file and adjacent lock
# inode from one shared volume; independent replicas/volumes are forbidden.
TINKER_EXECUTION_POLICY_STORE_PATH=./data/execution_policy_state.json
TINKER_EXECUTION_POLICY_STORE_INTEGRITY_KEY=
TINKER_EXECUTION_POLICY_STORE_INTEGRITY_KEY_PATH=tinker/execution_policy_store_integrity
# Comma-separated independent owner/reviewer Ethereum addresses. A policy PASS
# is persisted only after one configured signer signs the exact hash-only
# surface/resource/request/policy/expiry approval payload.
TINKER_EXECUTION_POLICY_APPROVED_SIGNERS=
# Canonical root of the sorted signer-address commitments. This must equal
# SHA-256("dnai-wikigen/execution-policy-approver-root/v1\0" || canonical JSON
# signer-hash array) and is immutable release evidence, not a secret.
TINKER_EXECUTION_POLICY_APPROVER_ROOT_HASH=
# Exact deployment domain:
# base-sepolia:84532:<release-manifest-commitment-64>:<compose-hash-0x64>:
# <sha256-phala-app-id-64>:<approver-root-64>. Its domain-separated digest is
# signed/stored. Any generic, reused, malformed, or root-mismatched domain is
# rejected before approval or execution.
TINKER_EXECUTION_POLICY_APPROVAL_DOMAIN=
# Monotonic Base Sepolia witness for the execution-policy journal. These are
# public, release-generated pins. The writer key is purpose-derived only inside
# the delegate CVM; there is deliberately no raw private-key setting.
TINKER_EXECUTION_POLICY_ANCHOR_RPC_URL=
TINKER_EXECUTION_POLICY_ANCHOR_ADDRESS=
TINKER_EXECUTION_POLICY_ANCHOR_RUNTIME_CODE_HASH=
TINKER_EXECUTION_POLICY_ANCHOR_WRITER_ADDRESS=
TINKER_EXECUTION_POLICY_ANCHOR_WRITER_RELEASE_COMMITMENT=
TINKER_EXECUTION_POLICY_ANCHOR_WRITER_KEY_PATH=tinker/execution_policy_anchor_writer
# One-shot writer-admission evidence uses a purpose-separated QVL deployment.
# The URL must be the final HTTPS /verify endpoint. The verifier address and
# policy hash are public reviewed release pins. The bearer is a Phala encrypted
# environment secret delivered only to the profile-gated ceremony container;
# never pass it to the long-running delegate, Arena, or Compute services.
TINKER_EXECUTION_POLICY_ANCHOR_WRITER_QVL_URL=
TINKER_EXECUTION_POLICY_ANCHOR_WRITER_QVL_VERIFIER_ADDRESS=
TINKER_EXECUTION_POLICY_ANCHOR_WRITER_QVL_RELEASE_POLICY_HASH=
TINKER_EXECUTION_POLICY_ANCHOR_WRITER_QVL_MAX_VERDICT_AGE_SECONDS=300
TINKER_EXECUTION_POLICY_ANCHOR_WRITER_QVL_AUTH_TOKEN=
TINKER_EXECUTION_POLICY_ANCHOR_CONFIRMATIONS=12
TINKER_EXECUTION_POLICY_ANCHOR_POLL_INTERVAL_SECONDS=1
TINKER_EXECUTION_POLICY_ANCHOR_CONFIRMATION_WAIT_SECONDS=60
TINKER_EXECUTION_POLICY_ANCHOR_MAX_BLOCK_AGE_SECONDS=3600
TINKER_EXECUTION_POLICY_ANCHOR_MAX_FUTURE_BLOCK_SKEW_SECONDS=30
# Public release-generated counterpart embedded in the SolidJS build. This is
# lowercase SHA-256 hex without a 0x prefix, never the secret approval signer.
VITE_EXECUTION_POLICY_APPROVAL_DOMAIN_HASH=
VITE_EXECUTION_POLICY_APPROVER_ROOT_HASH=
# Canonical JSON array of sorted lowercase signer-address commitments. The
# official release generator derives this from the immutable descriptor.
VITE_EXECUTION_POLICY_APPROVER_HASHES_JSON=
TINKER_API_KEY_STORE_PATH=./data/tinker_api_key.enc
TINKER_API_KEY_STORE_KEY=
TINKER_DSTACK_KEY_PATH=tinker/api_key
TINKER_PROJECT_ID=
TINKER_BASE_URL=
# disabled | stub | sft | deterministic. Stub is local-only; sft is retained
# research code and is unavailable in every custody mode. Production uses only
# the exact release-pinned deterministic three-policy registry below.
TINKER_EVALUATOR_MODE=disabled
# Canonical public manifest is created after the OCI image/bundle are known,
# passed through reviewed launch authority, and written by the networkless
# initializer to this exact dedicated sealed-volume path.
TINKER_DILIGENCE_EVALUATOR_RELEASE_B64=
TINKER_DILIGENCE_EVALUATOR_RELEASE_MANIFEST_PATH=/sealed/diligence/diligence-evaluator-release-v1.json
TINKER_DILIGENCE_EVALUATOR_RELEASE_MANIFEST_SHA256=
TINKER_DILIGENCE_EVALUATOR_POLICY_SET_ROOT=
TINKER_DILIGENCE_CHAIN_ID=84532
TINKER_DILIGENCE_ROOM_ADDRESS=
TINKER_ALLOW_TINKER_PROXY_ENDPOINT=false
TINKER_ALLOW_TINKER_PROXY_TOKEN_ISSUANCE=false
# Local/dev-only proxy JWT signing key. Leave empty in Phala so the delegate
# derives TINKER_PROXY_JWT_KEY_PATH from CVM-only dstack key material.
TINKER_PROXY_JWT_KEY=
TINKER_PROXY_JWT_KEY_PATH=tinker/proxy_jwt
TINKER_PROXY_JWT_DEFAULT_TTL_SECONDS=900
TINKER_PROXY_JWT_MAX_TTL_SECONDS=3600
TINKER_PROXY_JWT_ISSUER=dnai-wikigen:tinker-proxy
TINKER_PROXY_JWT_AUDIENCE=dnai-wikigen:tinker-delegate
# Optional comma-separated allowlist. Empty means the runtime-authenticated
# operator approval at issuance time is the only approval gate.
TINKER_PROXY_APPROVED_SUBJECTS=
# Optional hash-only issue policy. When required, proxy-token issuance fails
# closed unless the policy grants subject hash + recipient key hash + scopes +
# TTL cap. Spend scopes should also include scope_limits.max_amount_usd. The
# file must not contain raw user identities or secrets.
TINKER_PROXY_REQUIRE_ISSUE_POLICY=false
TINKER_PROXY_ISSUE_POLICY_PATH=
# Optional hash-only grant lifecycle gate. When true, matching issue-policy
# grants must have lifecycle.status=active, approved_by_hash, approved_at, and
# expires_at; pending/revoked/expired/future grants fail closed.
TINKER_PROXY_REQUIRE_GRANT_LIFECYCLE=false
# Optional reviewer-signature gate for grant lifecycle approval. When true,
# active grants must carry an Ethereum signed-message signature over the
# canonical hash-only grant approval payload, and approved_by_hash must match
# the reviewer signer address hash. The raw signature/address stays inside the
# policy file; API/CLI output returns only hashes.
TINKER_PROXY_REQUIRE_GRANT_LIFECYCLE_SIGNATURE=false
# Optional hash-only identity registry gate. When true, issue-policy subjects
# must be active user/agent identities and lifecycle approvers must be active
# reviewer/admin identities in this registry. The file must contain hashes only.
TINKER_PROXY_REQUIRE_IDENTITY_REGISTRY=false
TINKER_PROXY_IDENTITY_REGISTRY_PATH=
# Optional verifier-controlled identity-registry signature gate. When required,
# the hash-only registry must carry an Ethereum signed-message signature over
# its canonical registry hash from TINKER_PROXY_IDENTITY_REGISTRY_SIGNER.
TINKER_PROXY_REQUIRE_IDENTITY_REGISTRY_SIGNATURE=false
TINKER_PROXY_IDENTITY_REGISTRY_SIGNER=
# Local/offline verifier CLI only: private key used by
# sign-tinker-proxy-identity-registry. Do not deploy this into Phala or commit
# a real value.
TINKER_PROXY_IDENTITY_REGISTRY_SIGNER_KEY=
# Local/offline reviewer CLI only: private key used by
# sign-tinker-proxy-grant-lifecycle. Do not deploy this into Phala or commit a
# real value.
TINKER_PROXY_GRANT_REVIEWER_KEY=
# Optional deployment/contract gate for proxy-token issuance. When true,
# issuance checks the configured Tinker encumbrance contract and compose hash
# before minting scoped JWTs. Requires TINKER_ENCUMBRANCE_* below.
TINKER_PROXY_REQUIRE_DEPLOYMENT_POLICY=false
TINKER_PROXY_TOKEN_STORE_PATH=./data/proxy_tokens.enc
TINKER_PROXY_TOKEN_STORE_KEY=
TINKER_PROXY_TOKEN_KEY_PATH=tinker/proxy_tokens
TINKER_CLIENT_CONFIG_STORE_PATH=./data/tinker_client_config.enc
TINKER_CLIENT_CONFIG_STORE_KEY=
TINKER_CLIENT_CONFIG_KEY_PATH=tinker/client_config
TINKER_BROWSER_SESSION_STORE_PATH=./data/browser_session.enc
TINKER_BROWSER_SESSION_STORE_KEY=
TINKER_BROWSER_SESSION_KEY_PATH=tinker/browser_session
TINKER_FUNDING_RECEIPT_STORE_PATH=./data/funding_receipts.enc
TINKER_FUNDING_RECEIPT_STORE_KEY=
TINKER_FUNDING_RECEIPT_KEY_PATH=tinker/funding_receipts
TINKER_RUN_METADATA_STORE_PATH=./data/run_metadata.enc
TINKER_RUN_METADATA_STORE_KEY=
TINKER_RUN_METADATA_KEY_PATH=tinker/run_metadata
TINKER_CHAIN_CONTRACT_ADDRESS=
TINKER_CHAIN_CONTROL_PLANE_URL=http://localhost:8080
TINKER_CHAIN_START_BLOCK=
TINKER_CHAIN_POLL_INTERVAL=5.0
TINKER_CHAIN_CONFIRMATIONS=2
TINKER_CHAIN_CURSOR_STORE_PATH=./data/chain_watcher_cursor.json
TINKER_CHAIN_SIGNER_KEY_PATH=tinker/chain_signer
TINKER_CHAIN_SUBMIT_GAS_LIMIT=0
# Exact HTTPS DNS host[:port] targets accepted by the authenticated funding
# preflight endpoint. Wildcards, IP literals, paths, and HTTP are rejected.
TINKER_FUNDING_PREFLIGHT_ALLOWED_HOSTS=
# Deployment-only TinkerAccountEncumbrance draft settings. The fresh-suite
# helper requires explicit nonzero commitments, sets owner to
# DEPLOYMENT_OPERATOR, and always deploys halted. The draft cannot authorize an
# operation until the exact release inputs above complete both timed phases.
# TINKER_ENCUMBRANCE_OWNER is used only by the standalone deployment helper.
TINKER_ENCUMBRANCE_OWNER=
TINKER_ENCUMBRANCE_ACCOUNT_COMMITMENT=
TINKER_ENCUMBRANCE_INITIAL_COMPOSE_HASH=
TINKER_ENCUMBRANCE_MAX_ADD_BALANCE_WEI=5000000000000000000
TINKER_ENCUMBRANCE_MAX_SPEND_WEI=5000000000000000000
TINKER_ENCUMBRANCE_RPC_URL=
TINKER_ENCUMBRANCE_REQUIRED=false
TINKER_ENCUMBRANCE_COMPOSE_HASH=
TINKER_ENCUMBRANCE_POLICY_UNITS_PER_USD_WEI=1000000000000000000
TINKER_FUNDING_MODE=manual_prefund
TINKER_MIN_ADD_BALANCE_USD=10.0
TINKER_MAX_ADD_BALANCE_USD=10.0
TINKER_ALLOW_ADD_BALANCE_ENDPOINT=false
TINKER_DEBUG_ARTIFACT_DIR=
TINKER_PURGE_SECRET_DEBUG_ARTIFACTS=true
# Real Tinker SDK integration tests are disabled by default because they make
# paid API calls. Enable only inside the intended TEE/CVM or local test context
# with a low explicit budget cap.
TINKER_RUN_REAL_SDK_TESTS=false
TINKER_REAL_SDK_MAX_USD=0.05
TINKER_REAL_SDK_MODEL=Qwen/Qwen3-8B
TINKER_REAL_SDK_RANK=32
TINKER_ALLOW_TINKER_SMOKE_ENDPOINT=false
# Default spend cap for a bounded delegated `tinker:train` run (hard-capped at
# $5.00 in tinker_training). Proxy `tinker:train` tokens still require their own
# scope spend limit.
TINKER_TRAIN_MAX_USD=0.25
# Enables POST /tinker/train (bounded delegated LoRA training via the sealed
# account, operator token or scoped tinker:train proxy JWT). Disabled by default.
TINKER_ALLOW_TINKER_TRAIN_ENDPOINT=false
# Enables POST /tinker/keys/{list,create,delete} — full CDP key lifecycle
# management for the upstream account (operator-only). Can trigger auth emails.
TINKER_ALLOW_KEY_MANAGEMENT_ENDPOINT=false
# Local dev only: enables POST /billing/card with plaintext card JSON. Leave
# false for dstack/Phala and production; use /billing/card/encrypted instead.
TINKER_ALLOW_PLAINTEXT_CARD_ENDPOINT=false

# Development key (for local testing bypass)
DEV_KEY=

# ------------------------------------------------------------
# Infrastructure / DNS / CDN
# ------------------------------------------------------------

# Cloudflare (DNS management for TEE domains)
CLOUDFLARE_API_TOKEN=

# Domain configuration
DOMAIN=
CORS_ORIGIN=
GATEWAY_DOMAIN=

# TLS / Auth
JWT_SECRET=
CERTBOT_EMAIL=

# Database
PG_PASSWORD=
DB_PATH=./data.db

# ------------------------------------------------------------
# Integrations / Notifications
# ------------------------------------------------------------

# Telegram bot (deployment notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub Personal Access Token (Fine-grained)
# Used for:
#   1. GitHub Container Registry (GHCR) — pushing Docker images (docker login ghcr.io)
#   2. GitHub API — reading repos, creating issues via Octokit
#   3. CI/CD workflows — standard secrets.GITHUB_TOKEN (auto-provided by GitHub Actions)
#
# Required scopes (Fine-grained PAT):
#   read:packages / write:packages — Push/pull container images to GHCR
#   contents: read                 — Read repo contents
#   issues: read/write             — If agents need to create/read issues
#
# Create one at: GitHub Settings → Developer Settings → Personal Access Tokens → Fine-grained tokens
# Scope it to only the repos this project needs.
GITHUB_TOKEN=

# ------------------------------------------------------------
# Executor / Runtime Mode
# ------------------------------------------------------------

# Executor mode: docker | direct
EXECUTOR_MODE=docker

# Public visibility settings (Phala Trust Center)
PUBLIC_LOGS=true
PUBLIC_SYSINFO=true
LISTED=false
