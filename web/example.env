# Public Base Sepolia configuration. These values are embedded in the browser.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Independently hosted public HTTPS read-failover endpoint. Production release
# generation requires this to use a different provider origin from the primary.
# Browser failover is availability only, never dual-RPC activation evidence.
VITE_BASE_SEPOLIA_SECONDARY_RPC_URL=
VITE_RELEASE_SHA=
VITE_DILIGENCE_ROOM_ADDRESS=
# Ethereum keccak256 over the exact deployed runtime bytecode, including 0x.
VITE_DILIGENCE_ROOM_CODE_HASH=
VITE_DILIGENCE_ROOM_DEVELOPER=
# Immutable constructor observations. The initial developer is the deployment
# operator; writes stay locked until the distinct reviewed controller accepts
# the delayed handoff and becomes the current developer with no proposal left.
VITE_DILIGENCE_ROOM_INITIAL_DEVELOPER=
VITE_DILIGENCE_ROOM_RELEASE_GOVERNANCE_CONTROLLER=
VITE_DILIGENCE_RESULT_VERIFIER=
VITE_DILIGENCE_ATTESTATION_VERIFIER=
VITE_DILIGENCE_QVL_RELEASE_POLICY_HASH=
# Release-generated JSON array of exactly three public deterministic evaluator
# descriptors, ordered CSV, SFT JSONL, then VCF. Each descriptor contains only
# recipe, policy_commitment, display_schema, max_artifact_bytes=1048576, and
# policy_document_sha256. The browser recomputes the same sorted Solidity root
# and then verifies every commitment against the frozen on-chain set.
VITE_DILIGENCE_EVALUATOR_POLICIES_JSON=
VITE_DILIGENCE_EVALUATOR_POLICY_SET_ROOT=
VITE_CHALLENGE_REGISTRY_ADDRESS=
# Ethereum keccak256 over the exact ChallengeRegistry runtime bytecode.
VITE_CHALLENGE_REGISTRY_CODE_HASH=
VITE_ROYALTY_DISTRIBUTOR_ADDRESS=
VITE_ROYALTY_DISTRIBUTOR_CODE_HASH=
# Generated only from canonical post-transaction/pre-build Royalty history
# receipt H. These are public chain roles and digests, never signer material.
# The JSON values must be exact current v1 authority / phase-two-active state.
VITE_ROYALTY_RELEASE_AUTHORITY_JSON=
VITE_ROYALTY_RELEASE_ACTIVE_STATE_JSON=
VITE_ROYALTY_RELEASE_HISTORY_SHA256=
VITE_ROYALTY_RELEASE_HISTORY_RECEIPT_SHA256=
# Generated from the exact current final-authority v4 projection. Canonical
# false decisions remain valid but disabled. These values prove release
# configuration only, never fresh worker presence, TDX, QVL, or settlement.
VITE_ROYALTY_RELEASE_ACTIVE_STATE_SHA256=
VITE_FINAL_RELEASE_AUTHORITY_SHA256=
VITE_COLLABORATION_EXECUTION_RELEASE_VERIFICATION_SHA256=
VITE_COLLABORATION_EXECUTION_SERVICE=
VITE_COLLABORATION_EXECUTION_PROFILE=
VITE_COLLABORATION_EXECUTION_RELEASE_SHA=
VITE_COLLABORATION_EXECUTION_MAIN_RUNTIME_CVM_ID=
VITE_COLLABORATION_EXECUTION_ENABLED=false
VITE_COMPUTE_WORKLOAD_WALLET_ADOPTION_ENABLED=false
VITE_TINKER_ENCUMBRANCE_ADDRESS=
VITE_TINKER_ENCUMBRANCE_CODE_HASH=
VITE_EMAIL_ORACLE_AUTH_ADDRESS=
VITE_EMAIL_ORACLE_AUTH_CODE_HASH=
VITE_TEE_IDENTITY=
VITE_USDC_ADDRESS=

# Fail-closed contract write gate. Enable only after code hash, constructor
# roles, approval flags, compose hash, TEE identity binding, and token metadata
# are checked against the fresh deployment.
VITE_ENABLE_CONTRACT_WRITES=false

# Fresh project-owned Phala deployment only.
VITE_DELEGATE_URL=
# The email oracle has no browser/public endpoint. It is reachable only by the
# delegate over the CVM's private compose network.
VITE_PHALA_APP_ID=
VITE_PHALA_CVM_ID=
VITE_PHALA_COMPOSE_HASH=
VITE_PHALA_OS_IMAGE_HASH=
VITE_DELEGATE_IMAGE_DIGEST=

# Optional public WalletConnect Cloud project ID. This is not a wallet secret.
VITE_WALLETCONNECT_PROJECT_ID=
VITE_WALLET_AUTH_DOMAIN=www.wikigen.me
VITE_WALLET_AUTH_URI=https://www.wikigen.me
# Fresh project-owned, release-frozen monotonic execution-policy witness.
VITE_EXECUTION_POLICY_ANCHOR_ADDRESS=
# Ethereum keccak256 over the exact ExecutionPolicyAnchor runtime bytecode.
VITE_EXECUTION_POLICY_ANCHOR_CODE_HASH=
# Release-frozen dstack-derived writer and the exact manifest commitment it is
# authorized to anchor. Both are public trust roots, never private key data.
VITE_EXECUTION_POLICY_ANCHOR_WRITER=
VITE_EXECUTION_POLICY_ANCHOR_WRITER_RELEASE_COMMITMENT=
# Same-RPC reported-finalized plus confirmation-depth and freshness bounds
# shared by the browser and CVM verifier. The 3600-second release default
# tolerates Base Sepolia finalized-tag lag without changing exact block pinning.
# This is not a QVL, independent RPC quorum, or consensus-finality proof.
VITE_EXECUTION_POLICY_ANCHOR_CONFIRMATIONS=
VITE_EXECUTION_POLICY_ANCHOR_MAX_BLOCK_AGE_SECONDS=3600
VITE_EXECUTION_POLICY_ANCHOR_MAX_FUTURE_BLOCK_SKEW_SECONDS=
# Release-generated SHA-256 digest of the exact deployment-unique execution
# policy approval domain. The browser refuses to sign if the delegate differs.
VITE_EXECUTION_POLICY_APPROVAL_DOMAIN_HASH=
# Release-generated root over the exact sorted approver-hash set. This is a
# public signer-set commitment, not an address, private key, or authorization
# source on its own.
VITE_EXECUTION_POLICY_APPROVER_ROOT_HASH=
# Release-generated JSON array of lowercase SHA-256 approver commitments. The
# browser recomputes the root and refuses a signer or API response outside it.
VITE_EXECUTION_POLICY_APPROVER_HASHES_JSON=[]

# Fail-closed feature gate. Enable only after the fresh deployment, exact CORS
# origin, expected policy values, and independent quote checks are approved.
VITE_ENABLE_ARTIFACT_UPLOAD=false
# sha256:<64 lowercase hex> over the exact raw TDX quote bytes, populated only
# after an independent quote/collateral/measurement verifier approves it.
VITE_ARTIFACT_VERIFIED_QUOTE_SHA256=

# The authenticated Compute account API can be enabled independently from
# provider dispatch. It remains false until the fresh CVM, exact CORS origin,
# durable store, dstack key domains, and runtime bearer are verified.
VITE_ENABLE_COMPUTE_CONSOLE=false

# These wallet-authenticated product lanes have independent, release-derived
# gates. Neither is inferred from the broad Compute Console gate or from the
# other lane. Keep both false until each exact signed requested feature is
# reviewed and emitted by the release environment projector.
VITE_ENABLE_TINKER_CUSTOMER=false
VITE_ENABLE_COLLABORATION=false

# Ciphertext-only Compute workload ingress. These public values are accepted
# only as one complete, purpose-specific group projected from the signed final
# C-stage activation observation. Never copy Diligence or metering trust roots,
# and never set the gate from endpoint self-claims.
VITE_ENABLE_COMPUTE_WORKLOAD_UPLOAD=false
VITE_COMPUTE_WORKLOAD_QVL_VERIFIER=
# Exact O-derived ceremony lineage. These are public commitments, never keys.
VITE_COMPUTE_WORKLOAD_CVM_ID=
VITE_COMPUTE_WORKLOAD_DEPLOYMENT_INTENT_SHA256=
VITE_COMPUTE_WORKLOAD_RELEASE_AUTHORITY_SHA256=
VITE_COMPUTE_WORKLOAD_CEREMONY_NONCE=
VITE_COMPUTE_WORKLOAD_MEASUREMENT_POLICY_SET_SHA256=
VITE_COMPUTE_WORKLOAD_MEASUREMENT_POLICY_SHA256=
VITE_COMPUTE_WORKLOAD_MAIN_RUNTIME_EVIDENCE_SHA256=
VITE_COMPUTE_WORKLOAD_QVL_RELEASE_POLICY_HASH=
VITE_COMPUTE_WORKLOAD_COMPOSE_HASH=
# Exact nonzero lowercase bare 40-hex Phala app id.
VITE_COMPUTE_WORKLOAD_APP_ID=
# Exact nonzero lowercase bare 64-hex OS image hash.
VITE_COMPUTE_WORKLOAD_OS_IMAGE_HASH=
# Purpose-separated dstack-derived recipient-activation signer. The rejected
# legacy VITE_COMPUTE_WORKLOAD_EXECUTION_SIGNER name has no compatibility alias.
VITE_COMPUTE_WORKLOAD_ACTIVATION_SIGNER=
VITE_COMPUTE_WORKLOAD_CHAIN_ID=84532
VITE_COMPUTE_WORKLOAD_CONTRACT_ADDRESS=
VITE_COMPUTE_WORKLOAD_VAULT_RUNTIME_CODE_HASH=
VITE_COMPUTE_WORKLOAD_FRESH_DEPLOYMENT_RECEIPT_SHA256=
VITE_COMPUTE_WORKLOAD_MAX_VERDICT_AGE_SECONDS=120
VITE_COMPUTE_WORKLOAD_REVOKED_QUOTE_HASHES_JSON=[]

# ComputeCreditVault is a separate exact-asset capacity surface. Funding and
# authorization have separate feature flags, but both require the complete
# frozen live release root: runtime bytecode, developer, metering verifier and
# policy set, one TEE/compose pair, and exact native/ERC20 rate policies. Funding
# may be enabled while provider dispatch remains fail-closed; it is never a
# weaker bytecode-only trust mode.
VITE_COMPUTE_CREDIT_VAULT_ADDRESS=
# Ethereum keccak256 over the exact ComputeCreditVault runtime bytecode.
VITE_COMPUTE_CREDIT_VAULT_CODE_HASH=
VITE_ENABLE_COMPUTE_VAULT_FUNDING=false
VITE_ENABLE_COMPUTE_VAULT_AUTHORIZATION=false
VITE_COMPUTE_VAULT_DEVELOPER=
VITE_COMPUTE_VAULT_METERING_VERIFIER=
VITE_COMPUTE_VAULT_METERING_QVL_VERIFIER=
VITE_COMPUTE_VAULT_METERING_POLICY_SET_HASH=
# Exact frozen fee and payout recipients embedded by the reviewed release.
VITE_COMPUTE_VAULT_DEVELOPER_FEE_BPS=
# sha256:<64 lowercase hex> over the exact compute-metering TDX quote bytes,
# populated only after the dedicated independent compute-metering QVL approves
# the signer, vault, policy-set, release measurements, and dstack custody.
VITE_COMPUTE_METERING_VERIFIED_QUOTE_SHA256=
VITE_COMPUTE_VAULT_TEE_IDENTITY=
VITE_COMPUTE_VAULT_COMPOSE_HASH=
VITE_COMPUTE_VAULT_NATIVE_RATE_POLICY_COMMITMENT=
VITE_COMPUTE_VAULT_NATIVE_PROVIDER=

# Optional single exact ERC20 capacity asset. All metadata and runtime code
# must match live chain reads before the browser exposes funding.
VITE_COMPUTE_VAULT_ERC20_ASSET_ADDRESS=
VITE_COMPUTE_VAULT_ERC20_ASSET_CODE_HASH=
VITE_COMPUTE_VAULT_ERC20_SYMBOL=
VITE_COMPUTE_VAULT_ERC20_DECIMALS=
VITE_COMPUTE_VAULT_ERC20_RATE_POLICY_COMMITMENT=
VITE_COMPUTE_VAULT_ERC20_PROVIDER=

# Candidate submission additionally requires independent verification of the
# current Arena quote, recipient key/report-data binding, and challenge version.
VITE_ENABLE_ARENA_SUBMISSION=false
VITE_ARENA_VERIFIED_QUOTE_SHA256=
# Exact fail-closed bindings from each API catalog challenge version to its
# frozen, Open ChallengeRegistry version. The metadata hash must equal 0x plus
# catalog_manifest_hash. All bytes32 values use lowercase 0x-prefixed hex.
# Example (keep this on one line in a real .env):
# {"dnaseq-variant-qc-safe-ir@1.0.0":{"registry_challenge_id":"1","registry_version":1,"catalog_manifest_hash":"0812d8ab6cb26d60f1c28f6696773bd05a47e89fecc0ac6f28447ab0624f058f","metadata_uri":"ipfs://<cid>","metadata_hash":"0x0812d8ab6cb26d60f1c28f6696773bd05a47e89fecc0ac6f28447ab0624f058f","sealed_artifact_commitment":"0x<64 lowercase hex>","evaluator_commitment":"0x<64 lowercase hex>","release_policy_commitment":"0x<64 lowercase hex>"}}
VITE_ARENA_CHALLENGE_REGISTRY_BINDINGS_JSON=
# Domain-separated SHA-256 of the complete exact bindings JSON above. The
# browser recomputes it before selecting a challenge. New public registry rows
# remain unapproved until a later reviewed release emits a new set and digest.
VITE_ARENA_APPROVED_CHALLENGE_SET_SHA256=
