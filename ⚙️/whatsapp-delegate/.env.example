# WhatsApp Delegate — environment configuration
#
# Copy to .env and customize:
#   cp .env.example .env

# App host port (default 8200, maps to container port 8000)
WA_APP_PORT=8200

# Seal key (hex, 32 bytes) — leave empty to auto-generate in local dev
# In TEE mode (dstack), this is ignored — key is derived from CVM identity
WA_SEAL_KEY_HEX=

# Pre-approved pipeline digests (comma-separated sha256:...)
# Only these docker images can query the sealed data
WA_APPROVED_PIPELINES=
