# Config for deploying "The Gate: Health" onto a dstack-webhost tee-daemon.
# Copy to `webhost.env` (gitignored) and fill in. Both scripts source it.
#
#   cp webhost.env.example webhost.env

# --- Phase B: deploy-gate.sh (deploy the built app onto a running daemon) -----

# The tee-daemon's public URL. After provision-daemon.sh this is the Phala CVM
# gateway URL, shaped like https://<app-id>-8080.<node>.phala.network
CVM_URL=

# The daemon's admin token (TEE_DAEMON_TOKEN it was booted with).
# provision-daemon.sh generates one and writes it here.
TEE_DAEMON_TOKEN=

# Project name the gate is hosted under (served at $CVM_URL/$PROJECT_NAME/).
PROJECT_NAME=wikigen-gate

# --- Phase A: provision-daemon.sh (bring up the daemon on Phala) --------------

# Pulled from the tinker-delegate .env if left blank (PHALA_CLOUD_API_KEY).
PHALA_CLOUD_API_KEY=

# Name for the daemon CVM on Phala Cloud.
DAEMON_CVM_NAME=wikigen-tee-daemon

# Phala instance type / KMS (mirror tinker-delegate example.env defaults).
PHALA_INSTANCE_TYPE=tdx.medium
PHALA_KMS_TYPE=phala

# Pin the dstack-webhost source to a specific ref for reproducibility.
DSTACK_WEBHOST_REPO=https://github.com/amiller/dstack-webhost
DSTACK_WEBHOST_REF=main
