# TEE Email Oracle — environment configuration
#
# Copy to .env and customize:
#   cp .env.example .env

# Credential encryption key (32-byte hex string)
# Leave empty to auto-generate on first run (local dev only)
# In dstack TEE: leave empty — key comes from derive_key()
ORACLE_CRED_STORE_KEY=

# Email domain for new accounts
# Options: firemail.cc, airmail.cc, cock.li, cock.email, etc.
ORACLE_DOMAIN=firemail.cc

# Runtime API auth for sensitive OTP/inbox egress.
# Local dev: set this and TINKER_ORACLE_AUTH_TOKEN to the same high-entropy value.
# dstack/Phala: leave token empty and set ORACLE_RUNTIME_AUTH_REQUIRED=true so
# the token is derived from ORACLE_RUNTIME_AUTH_KEY_PATH inside the CVM.
ORACLE_RUNTIME_AUTH_REQUIRED=false
ORACLE_RUNTIME_AUTH_TOKEN=
ORACLE_RUNTIME_AUTH_KEY_PATH=oracle/runtime-auth

# Production on-chain authorization. Both RPC URLs must be HTTPS and use
# different hosts. Every read is pinned to one common finalized Base Sepolia
# block and to the deployed EmailOracleAuth runtime code hash.
ORACLE_PRODUCTION_RELEASE=false
ORACLE_DSTACK_ENABLED=false
ORACLE_DSTACK_KEY_PATH=email/creds
ORACLE_AUTH_REQUIRED=false
ORACLE_AUTH_CONTRACT_ADDRESS=
ORACLE_AUTH_RPC_URL=
ORACLE_AUTH_RPC_URL_SECONDARY=
ORACLE_AUTH_CHAIN_ID=84532
ORACLE_AUTH_CONTRACT_RUNTIME_CODE_HASH=
ORACLE_AUTH_CONSUMER_APP_ID=
ORACLE_AUTH_CONSUMER_COMPOSE_HASH=
ORACLE_AUTH_EXPECTED_CALLER_IDENTITY=tinker-delegate.signup
ORACLE_AUTH_MAX_FINALIZED_BLOCK_AGE_SECONDS=900
ORACLE_AUTH_MAX_FUTURE_BLOCK_SKEW_SECONDS=30
ORACLE_AUTH_CHECKPOINT_STORE_PATH=/data/email_auth_checkpoint.json

# Encrypted OTP replay ledger. Stores OTP-use hashes, not OTP values.
# Local dev may set ORACLE_OTP_REPLAY_STORE_KEY; dstack/Phala derives from
# ORACLE_OTP_REPLAY_KEY_PATH.
ORACLE_OTP_REPLAY_STORE_PATH=/data/otp_replay.enc
ORACLE_OTP_REPLAY_STORE_KEY=
ORACLE_OTP_REPLAY_KEY_PATH=email/otp_replay
