{
  "$id": "https://wikigen.me/schemas/release-reviewer-roster.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit public finite reviewer-key inventory and exactly two independent status guardians supplied to genesis-init. This roster is not a signature or release authority.",
  "properties": {
    "reviewer_controllers": {
      "items": {
        "$ref": "#/$defs/reviewer_controller"
      },
      "maxItems": 32,
      "minItems": 2,
      "type": "array"
    },
    "schema": {
      "const": "dnai.release-reviewer-roster.v2"
    },
    "status_guardians": {
      "items": {
        "$ref": "#/$defs/identity"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "required": [
    "reviewer_controllers",
    "schema",
    "status_guardians"
  ],
  "title": "dnai-wikigen explicit reviewer authority roster v2",
  "type": "object",
  "$defs": {
    "address": {
      "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{7,63}$",
      "type": "string"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "controller_id": {
          "$ref": "#/$defs/controller_id"
        }
      },
      "required": [
        "address",
        "controller_id"
      ],
      "type": "object"
    },
    "reviewer_controller": {
      "additionalProperties": false,
      "properties": {
        "controller_id": {
          "$ref": "#/$defs/controller_id"
        },
        "preauthorized_addresses": {
          "items": {
            "$ref": "#/$defs/address"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "controller_id",
        "preauthorized_addresses"
      ],
      "type": "object"
    }
  }
}
