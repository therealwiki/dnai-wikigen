{
  "$id": "https://wikigen.me/schemas/phala-nonlive-bootstrap-authorization.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Two externally supplied, transitively allowlisted EIP-191 signatures authorize exactly one fresh seven-CVM Phala bootstrap prepare/commit batch. This artifact is not authority for post-measurement secrets, a governance ceremony, live traffic, Cloudflare, a TDX measurement, or evidence that any mutation occurred.",
  "properties": {
    "action_scope": {
      "const": [
        "phala.nextAppIds.predict_exact_seven",
        "phala.provisionCvm.prepare_exact_seven_supporting_then_main",
        "phala.commitCvmProvision.bootstrap_exact_seven_supporting_then_main"
      ]
    },
    "authorization_id": {
      "$ref": "#/$defs/sha256"
    },
    "batch_id": {
      "$ref": "#/$defs/sha256"
    },
    "bootstrap_public_environment_authority_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "chain_id": {
      "const": 84532
    },
    "cvm_launch_intent_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cvm_launch_review_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "deployment_intent_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expires_at": {
      "$ref": "#/$defs/utc_second"
    },
    "forbidden_scope": {
      "const": [
        "post_measurement_secret_activation",
        "governance_release_ceremony",
        "live_traffic",
        "cloudflare_deploy"
      ]
    },
    "fresh_contract_deployment_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "issued_at": {
      "$ref": "#/$defs/utc_second"
    },
    "image_release_sigstore_verification_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "production_target_authority_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qvl_measurement_policy_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "release_sha": {
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
      "type": "string"
    },
    "reviewer_root_hash": {
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "reviewer_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewers": {
      "items": {
        "$ref": "#/$defs/reviewer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "schema": {
      "const": "dnai.phala-nonlive-bootstrap-authorization.v3"
    },
    "sdk_wire_transform_staging_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "signature_scheme": {
      "const": "eip191_personal_sign_secp256k1_low_s_65_byte"
    },
    "signature_verifier": {
      "additionalProperties": false,
      "const": {
        "build_profile": "maxperf",
        "commit_sha": "b0a9dd9ceda36f63e2326ce530c10e6916f4b8a2",
        "executable_sha256": "f7373e6e34939415fe048560ecf275463ea891fec5a124a38958983f3955542d",
        "executable_user_relative_path": ".foundry/bin/cast",
        "tool": "cast wallet verify",
        "version": "1.5.1-stable"
      },
      "type": "object"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "signed_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "non_live_bootstrap_authorized"
    },
    "truth_status": {
      "const": "two_transitively_allowlisted_eip191_signatures_authorize_one_non_live_seven_cvm_bootstrap_batch_not_late_secrets_governance_live_traffic_or_cloudflare"
    }
  },
  "required": [
    "action_scope",
    "authorization_id",
    "batch_id",
    "bootstrap_public_environment_authority_sha256",
    "chain_id",
    "cvm_launch_intent_sha256",
    "cvm_launch_review_receipt_sha256",
    "deployment_intent_sha256",
    "expires_at",
    "forbidden_scope",
    "fresh_contract_deployment_receipt_sha256",
    "issued_at",
    "image_release_sigstore_verification_receipt_sha256",
    "production_target_authority_sha256",
    "qvl_measurement_policy_set_sha256",
    "release_sha",
    "reviewer_root_hash",
    "reviewer_set_sha256",
    "reviewers",
    "schema",
    "sdk_wire_transform_staging_receipt_sha256",
    "signature_scheme",
    "signature_verifier",
    "signatures",
    "signed_payload_sha256",
    "status",
    "truth_status"
  ],
  "title": "dnai-wikigen non-live Phala bootstrap authorization",
  "type": "object",
  "$defs": {
    "address": {
      "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{7,63}$",
      "type": "string"
    },
    "reviewer": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "controller_id": {
          "$ref": "#/$defs/controller_id"
        }
      },
      "required": [
        "address",
        "controller_id"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "controller_id": {
          "$ref": "#/$defs/controller_id"
        },
        "signature": {
          "pattern": "^0x[0-9a-f]{130}$",
          "type": "string"
        }
      },
      "required": [
        "address",
        "controller_id",
        "signature"
      ],
      "type": "object"
    },
    "utc_second": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  }
}
